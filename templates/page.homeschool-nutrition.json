    "section_icons_row_7a7DML": {
      "type": "section-icons-row",
      "blocks": {
        "text_w7d8rC": {
          "type": "text",
          "settings": {
            "icon_name": "organic",
            "title": "Nutrition Advice",
            "text": "<p>A healthy diet is the foundation of your pet’s overall well-being, impacting everything from energy levels and digestion to skin health, longevity, and even behavior.</p><ul><li>Diet Review</li><li>Guidance and help with formulating home made diets</li><li>Weight Management</li><li>Understanding commercial pet food and how to read food labels</li><li>Nutrition-intake Calculator</li><li>& More</li></ul>"
          }
        },
        "text_yPCxDe": {
          "type": "text",
          "settings": {
            "icon_name": "paw-heart",
            "title": "Vitamins and Supplements",
            "text": "<p>Receive expert guidance to help you choose safe, effective, and science-backed options tailored to your dog’s unique needs</p><ul><li>Essential Vitamins & Minerals</li><li>Joint & Mobility Support</li><li>Gut & Digestive Health </li><li>Skin & Coat Wellness </li><li>Immune & Overall Well-Being </li></ul>"
          }
        },
        "text_rxQEFy": {
          "type": "text",
          "settings": {
            "icon_name": "heart",
            "title": "Holistic Wellness",
            "text": "<p>Our in house pet nutrition expert takes a whole-body approach, focusing on natural, species-appropriate diets and lifestyle factors that support long-term wellness.</p><ul><li>Understanding Food Options from Prey Model, Raw, Homecooked to Commercial</li><li>Natural Remedies & Supplements</li><li>Allergy & Sensitivity Management</li><li>Longevity & Preventative Health</li></ul>"
          }
        }
      },
      "block_order": [
