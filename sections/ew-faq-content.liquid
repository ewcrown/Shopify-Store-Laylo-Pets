<section class="objection-breakers-section">
  <div class="wrapper">
    <div class="objection-breakers-container">
      {% if section.settings.image != blank %}
        <div class="objection-breakers-image">
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Objection Breakers Image" loading="lazy">
        </div>
      {% endif %}

      <div class="objection-breakers-content">
        {% if section.settings.heading != blank %}
          <h2 class="objection-breakers-title">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="accordion">
          {% for block in section.blocks %}
            {% if block.settings.question != blank and block.settings.answer != blank %}
              <div class="accordion-item">
                <button class="accordion-header">
                  {{ block.settings.question }}
                  <span class="accordion-icon"><i class="fas fa-plus"></i></span>
                </button>
                <div class="accordion-body">
                  <p>{{ block.settings.answer }}</p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .objection-breakers-section {
    padding: 60px 20px;
    background: #fff;
  }

  .objection-breakers-container {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .accordion-header.active::after {
    display: none;
  }

  .objection-breakers-image {
    flex: 1 1 45%;
  }

  .objection-breakers-image img {
    width: 100%;
    border-radius: 12px;
  }

  .objection-breakers-content {
    flex: 1 1 50%;
  }

  .objection-breakers-title {
    font-size: 32px;
    margin-bottom: 30px;
    font-family: serif;
  }

  .accordion-item {
    border: 1px solid #e3e3e3;
    border-radius: 6px;
    margin-bottom: 12px;
    overflow: hidden;
    background: #f4f2ef;
  }

  .accordion-header {
    width: 100%;
    padding: 16px 20px;
    background: transparent;
    border: none;
    text-align: left;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .accordion-icon i {
    transition: transform 0.3s;
  }

  .accordion-header.active .accordion-icon i {
    content: '\f068'; /* minus icon */
  }

  .accordion-header.active .fa-plus {
    display: none;
  }

  .accordion-header.active::after {
    content: '';
  }

  .accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: #fff;
    padding: 0 20px;
  }

  .accordion-body p {
    margin: 15px 0;
    font-size: 14px;
    color: #333;
  }

  .accordion-header.active + .accordion-body {
    padding: 16px 20px;
  }

  @media (max-width: 768px) {
    .objection-breakers-container {
      flex-direction: column;
    }
    .objection-breakers-image,
    .objection-breakers-content {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const headers = document.querySelectorAll(".accordion-header");

    headers.forEach((header) => {
      header.addEventListener("click", () => {
        const body = header.nextElementSibling;
        const icon = header.querySelector(".accordion-icon i");

        // Close all others
        headers.forEach(h => {
          if (h !== header) {
            h.classList.remove("active");
            h.nextElementSibling.style.maxHeight = null;
            h.querySelector(".accordion-icon").innerHTML = '<i class="fas fa-plus"></i>';
          }
        });

        // Toggle clicked one
        const isActive = header.classList.contains("active");
        if (isActive) {
          header.classList.remove("active");
          body.style.maxHeight = null;
          icon.className = "fas fa-plus";
        } else {
          header.classList.add("active");
          body.style.maxHeight = body.scrollHeight + "px";
          icon.className = "fas fa-minus";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Text | Faqs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objection Breakers"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "I don’t have time."
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Here’s a short response that helps overcome this objection."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Text | Faqs",
      "blocks": [
        {
          "type": "accordion_item"
        },
        {
          "type": "accordion_item"
        },
        {
          "type": "accordion_item"
        }
      ]
    }
  ]
}
{% endschema %}