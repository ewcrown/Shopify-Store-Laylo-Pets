        "template--16059995881658__be3df09a-d824-47c3-9f1b-7f615dd1a652-1678648411145a7169-2": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-03-15_at_7.36.36_AM.png",
            "title": "Etsy x Altuzarra",
            "text": "<p>We developed a custom collection alongside designer Joseph Altuzarra in partnership with Etsy. Later that year we became a Etsy design finalist. <em>Image: Elle Decor</em></p>",
            "button_text": "2020",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "template--16059995881658__be3df09a-d824-47c3-9f1b-7f615dd1a652-1678648411145a7169-3": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/slide_4.jpg",
            "title": "New collections",
            "text": "<p>We continued to launch new patterns and colors, such as Terra, Sage, and Terrazzo — a launch complete with a photoshoot to benefit the animal shelter in Palm Springs.</p>",
            "button_text": "2021",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
