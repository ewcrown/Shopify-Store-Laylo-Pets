        "text_block_TwJbPQ": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-07-01_at_11.58.30_AM.png",
            "title": "\"LAY LO helped our dog overcome his resource guarding issues. Our pup has a little anxiety, so having a stranger in our house may have prevented her from learning. Everything worked out really well and I would definitely recommend them.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Sarah & Amelia<br/></strong>Twinsburg, OH</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
