        "text_block_gWKYfi": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/386430789_659185492994198_6348077567033783363_n.jpg",
            "title": "\"I’ve gone from having a puppy who tears everything apart to a very lovely little pup who actually listens to me without commands. I can’t thank the team enough for making my life a lot easier.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Linnea & Cookie<br/></strong>Westfield, NJ</p>",
            "button_text": "",
            "button_link": "https://youtu.be/BVtXKLKEvbM",
