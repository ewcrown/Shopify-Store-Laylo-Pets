            "top_image_width": 100,
            "text_color": "text-dark",
            "subheading": "$25 / Week",
            "title": "Homeschool Lite",
            "text": "<p><strong>Message on-demand with certified  dog experts and get 1:1 help twice a week. <br/><br/>Cancel anytime.</strong><br/><br/><br/>Message-an-Expert</p><p>1x Practice Session (15-min)</p><p>LAY LO™ Product Discounts</p><p>* * * </p><p>Insider Community Access</p><p>Course Membership Library - Limited Access</p>",
            "button_text": "Join Now",
            "button_link": "shopify://products/copy-of-homeschool-lite-on-demand-messaging-with-dog-experts",
