{% schema %}
{
  "name": "Dark Footer",
  "tag": "section",
  "class": "ew-dark-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "2024. All rights reserved."
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    }
  ],
  "presets": [
    {
      "name": "Dark Footer"
    }
  ]
}
{% endschema %}

<div class="ew-dark-footer">
  <div class="wrapper">
    <div class="footer-top">
      <div class="footer-logo">
        {% if section.settings.footer_logo %}
          <img src="{{ section.settings.footer_logo | image_url }}" alt="Footer Logo" />
        {% else %}
          <img src="{{ 'laylo-logo.svg' | asset_url }}" alt="LAY•LO Logo" />
        {% endif %}
      </div>
      <div class="footer-socials">
        {% if section.settings.facebook_url %}
          <a href="{{ section.settings.facebook_url }}" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        {% endif %}
        {% if section.settings.instagram_url %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        {% endif %}
        {% if section.settings.twitter_url %}
          <a href="{{ section.settings.twitter_url }}" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
        {% endif %}
        {% if section.settings.linkedin_url %}
          <a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        {% endif %}
      </div>
    </div>

    <hr class="footer-divider" />

    <div class="footer-bottom">
      <p>{{ section.settings.footer_text }}</p>
      <div class="footer-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/cookies">Cookies Settings</a>
      </div>
    </div>
  </div>
</div>

{% style %}
.ew-dark-footer {
  background-color: #2D2E31;
  color: #fff;
  padding: 40px 20px;
  font-family: sans-serif;
}

.ew-dark-footer .footer-inner {
  max-width: 1200px;
  margin: 0 auto;
}

.ew-dark-footer .footer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom:80px;
}

.ew-dark-footer .footer-logo img {
    height: 53px;
}

.ew-dark-footer .footer-socials a {
  color: #fff;
  margin-left: 16px;
  font-size: 18px;
  text-decoration: none;
}

.ew-dark-footer .footer-divider {
    border: none;
    border-top: 1px solid #FFFFFF;
    width: 100%;
}

.ew-dark-footer .footer-bottom {
  display: flex;
  justify-content:center;
  align-items: center;
  font-size: 14px;
}

.ew-dark-footer .footer-links {
  display:flex;
  justify-content:center;
}
.ew-dark-footer .footer-links a {
  color: #fff;
  margin-left: 20px;
  text-decoration: underline;
}

.footer-bottom * {
  width:auto;
}

@media screen and (max-width: 768px) {
  .ew-dark-footer .footer-top {
    margin-bottom:30px;
  }
  .ew-dark-footer .footer-bottom {
    margin-top:30px
  }
  .ew-dark-footer .footer-top,
  .ew-dark-footer .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }

  .ew-dark-footer .footer-links {
    flex-direction:column;
    gap:20px;
  }

  .ew-dark-footer .footer-links a {
    margin: 0 10px;
  }
}
{% endstyle %}