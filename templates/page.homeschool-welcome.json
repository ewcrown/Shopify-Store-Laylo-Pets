        "template--16127693848762__a1fef923-1a06-42e5-8281-acf46898dc66-16865153063e704aed-2": {
          "type": "text_block",
          "settings": {
            "title": "Pup Behavioral Modification Plan",
            "text": "<p>We'll share an assessment for what is needed to reach your goals at home, including the cues you should teach and roughly how long it will take to improve it. </p>",
            "button_text": "",
            "calendly_widget": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "template--16127693848762__a1fef923-1a06-42e5-8281-acf46898dc66-16865153063e704aed-0": {
          "type": "text_block",
          "settings": {
            "title": "Homeschool's Daily Enrichment Routine",
            "text": "<p>Dog's need a calculated amount of exercise, mental stimulation and enrichment to avoid destructive behavior. We'll evaluate your routine together to ensure your dog is receiving the proper amount of stimulation at home. </p>",
            "button_text": "",
            "calendly_widget": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        }
