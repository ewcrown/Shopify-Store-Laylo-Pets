          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/LAY-LO-Pets-Boho-Dog-Beds.jpg",
            "title": "First collections",
            "text": "<p>Inspired by the global fabrics we found around the world, we developed a unique, yet durable knit material and launched our first collection, Boho, in May of 2019.</p>",
            "button_text": "2019",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
