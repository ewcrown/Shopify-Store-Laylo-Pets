        "accordion_block_2_0": {
          "type": "text",
          "settings": {
            "title": "How long does it take to get my products?",
            "text": "<p>Products are shipped from our Brooklyn warehouse Monday-Friday.<br/><br/>Domestic shipping can take up to 3-8 business days, depending on the location. We typically ship USPS or UPS ground.<br/><br/>Foreign shipping could take up to 14 business days.<br/><br/></p>"
          }
        },
        "accordion_block_2_1": {
          "type": "text",
          "settings": {
            "title": "How much does it cost?",
            "text": "<p>Shipping is free to domestic US states on orders over $100. Orders under $100 shipping to a domestic location are $5. <br/><br/>International shipping rates are calculated depending on shipping destination.</p>"
          }
        },
        "accordion_block_2_2": {
          "type": "text",
          "settings": {
            "title": "Is there free shipping?",
            "text": "<p>Yes, we offer free shipping on domestic orders over $100!</p>"
          }
        },
        "accordion_block_2_3": {
          "type": "text",
          "settings": {
            "title": "Do you ship internationally?",
            "text": "<p>Yes, we ship our products all over the globe. The fees and VAT are calculated during the checkout process once you input your shipping address.<br/><br/>Please note that free shipping is not applicable for international orders and that shipping rates could vary depending on your region.</p>"
          }
        },
        "accordion_block_2_4": {
          "type": "text",
          "disabled": true,
          "settings": {
            "title": "Do you ship to my area?",
            "text": "<p>A full list of all of our shipping areas can be found <a href=\"/policies/shipping-policy\" title=\"Shipping Policy\">here</a>.<br/><br/>If your country or region is not mentioned, please feel free to reach out to see if we can work out the details.</p>"
          }
        }
