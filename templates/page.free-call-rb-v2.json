    "section_image_with_text_JgYX7L": {
      "type": "section-image-with-text",
      "settings": {
        "section_height": "seven-fifty-height",
        "layout": "inline",
        "image_location": "left",
        "image_width": "standard",
        "image": "shopify://shop_images/Sessions_Hero_Image_d6d3c828-ef40-49b2-9e56-41c3714c16cd.png",
        "subheading": "OUR VIRTUAL TRAINING METHOD",
        "title": "<p>Real, Impactful Help for the Modern Dog Parent</p>",
        "heading_highlight_type": "circle",
        "heading_size": 130,
        "text_content": "Because real life doesn’t happen in a training studio. It happens on your couch, by your front door, in the middle of dinner, when your dog decides now is the moment to lose their mind.\n\nStructure that fits real life\nYou’ll get weekly 1:1 sessions with a certified trainer, plus bite-sized check-ins and unlimited text support between calls—so you’re never stuck Googling, guessing, or going it alone.\n\nWe train the human, not just the dog\nYour habits, your energy, your voice—it all matters. That’s why we coach you, helping you build the calm, confident leadership your dog actually listens to.\n\nPersonalized to your pup—and your home\nWhether you’re in a high-rise or have a yard, raising a puppy or managing a reactive rescue, we build a plan around your dog’s breed, age, temperament—and your daily life.\n\nBuilt for busy people\nNo driving across town. No rescheduling your week. No pressure to perform in front of strangers. Just flexible, expert-backed support that fits in quietly and consistently.\n\nNo second-guessing. No “what now?” moments.\nYou’ll always know what to do next—and why. And you’ll have someone in your corner to help you stay calm, consistent, and on track.",
        "text_alignment": "left",
        "button_text": "Book Your Free Behavior Call →",
        "button_link": "shopify://pages/free-consultation-booking-page",
        "button_style": "btn--primary",
        "video_link": "",
        "text_color": "text-dark",
        "bg_color": "#f5f5f5",
        "section_width": "wrapper",
        "padding_top": 100,
        "padding_bottom": 100
      }
    },
