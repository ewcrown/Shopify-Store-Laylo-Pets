          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Video_Thumbnail_1.png",
            "title": "Make immediate progress alongside a dog expert.",
            "text": "<p>After the call, we'll place you with your dedicated, certified expert to work with you and your pup 1-on-1 and solve your toughest issues together. This is not a group class, this is a personal program just for you.</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
