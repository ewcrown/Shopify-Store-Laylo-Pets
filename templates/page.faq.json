    "accordion-section-4": {
      "type": "section-accordions",
      "blocks": {
        "accordion_block_4_0": {
          "type": "text",
          "settings": {
            "title": "What is your return policy?",
            "text": "<p><strong>For LAY LO Beds and Bed Covers:</strong> if you have not opened the vacuum seal or original packaging, you will be eligible for a return or an exchange of size. Returns must be requested within 30 days of the  purchase date. LAY LO beds must be unopened for a return or a refund.  <br/><br/><strong>Liners, toys, and and other products</strong> must be unused to be eligible for a return. </p><p>For <strong>exchange items</strong>, please see \"How do I exchange a product?\" in the questions below. </p><p>If you wish to return or exchange your items, knowing the above, please contact our team at <a href=\"mailto:support@laylopets.com\">support@laylopets.com</a> for return details. Please provide your order number and photo of your product. </p><p>Return shipping of a LAY LO bed will be subject to a $20 return fee, which will be deducted from your final refund amount. Other returned products will be subject to a $5 fee. </p><p>Once the product is received and passes inspection, the payment will be processed to the original payment method and the customer will receive an email notification.</p>"
          }
        },
        "accordion_block_4_1": {
          "type": "text",
          "settings": {
            "title": "How long after I complete a purchase can I ask for a refund?",
            "text": "<p>A refund request can be submitted within a month after the purchase is made, pending the requirements are met in our return policy above. Email support@laylopets.com to request a refund. Please include your order number and photo of the packaged product.</p>"
          }
        },
        "accordion_block_4_2": {
          "type": "text",
          "settings": {
            "title": "How much can I get refunded?",
            "text": "<p>In the case when the <strong>product and packaging are unopened and undamaged</strong>, you are<strong> eligible </strong>for a full refund.*<br/><br/>In the case when<strong> the packaging has been opened and the product has been used</strong>, you are <strong>eligible</strong> for a partial refund.*<br/><br/>In the case when a<strong> product has been damaged</strong>, and the damage is not covered by your warranty, you are<strong> not eligible </strong>for a refund.*<br/><br/>*Dog bed mattresses that have been opened and used are eligible for exchange but not a refund. Eligible returned or exchanged items are subject to up to a restocking and shipping fee. <br/></p>"
          }
        },
        "accordion_block_4_3": {
          "type": "text",
          "settings": {
            "title": "How do I exchange a product?",
            "text": "<p>Exchanges happen, we understand. <br/><br/>We recommend viewing our size chart before your purchase and ensuring you pick the best size for your pup. <br/><br/>Bed exchanges are subject to a $20 exchange shipping and handling fee.<br/><br/>All other products are subject to a $5 exchange shipping and handling fee.</p>"
          }
        },
        "accordion_block_4_4": {
          "type": "text",
          "disabled": true,
          "settings": {
            "title": "Who pays the shipping costs in the case of a refund when the order has free shipping?",
            "text": "<p>When an order includes free shipping, only the cost of the return shipping is handled by the customer.</p>"
          }
        }
      },
