{% style %}
  #ew-expert-slider-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    text-align: center;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-heading {
color: var(--Black, #1B1B1B);
text-align: center;
font-size: 48px;
font-style: normal;
font-weight: 400;
line-height: 56px; /* 116.667% */
    margin-bottom: 8px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-subheading {
color: var(--Black, #1B1B1B);
text-align: center;
font-family: "DM Sans";
font-size: 30px;
font-style: normal;
font-weight: 400;
line-height: 34.23px; /* 114.098% */
    margin-bottom: 40px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-card {
    background: #f9f9f9;
    padding: 20px;
    border-radius: 12px;
    text-align: left;
    height: 100%;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 15px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-card h3 {
    color: #000;
font-family: Inter;
font-size: 16px;
font-style: normal;
font-weight: 400;
line-height: 23.553px; /* 147.208% */
    margin-bottom: 10px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-card p:not(.expert-label) {
    color: #000;
font-family: "DM Sans";
font-size: 16.487px;
font-style: normal;
font-weight: 400;
line-height: 20px; /* 121.305% */
  }
  #ew-expert-slider-section-{{ section.id }} .expert-label {
    color: #000;
font-family: "DM Sans";
font-size: 16.487px;
font-style: normal;
font-weight: 500;
line-height: 25.767px; /* 156.286% */
    margin-bottom: 4px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-button-wrap {
    margin-top: 40px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-button {
    font-size: 24px;
    padding: 16px 40px;
    margin-top: 20px;
  }

  #ew-expert-slider-section-{{ section.id }} .expert-button:hover {
    background-color: #162033;
  }

  @media(max-width:479px){
    #ew-expert-slider-section-{{ section.id }} {
      padding:40px var(--gutter-mobile)
    }
    #ew-expert-slider-section-{{ section.id }} .expert-heading {
      font-size: 30px;
      line-height: 40px;
    }
    #ew-expert-slider-section-{{ section.id }} .expert-subheading {
      font-size: 18px;
      line-height: normal;
      margin-bottom: 40px;
    }
    #ew-expert-slider-section-{{ section.id }} .expert-button {
      font-size: 18px;
      padding: 16px;
    }
  }
{% endstyle %}

<section class="expert-slider-section" id="ew-expert-slider-section-{{ section.id }}">
  <div class="container">
    <h2 class="expert-heading">{{ section.settings.heading }}</h2>
    <p class="expert-subheading">{{ section.settings.subheading }}</p>

    <div class="splide" id="expert-slider-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide">
              <div class="expert-card">
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}">
                {% endif %}
                <h3>{{ block.settings.name }}</h3>
                <p class="expert-label">{{ block.settings.cert_heading }}</p>
                <p>{{ block.settings.certifications | newline_to_br }}</p>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <div class="expert-button-wrap">
        <a href="{{ section.settings.button_link }}" class="btn btn--primary expert-button">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('#expert-slider-{{ section.id }}', {
      focus  : 'center',
      type: 'loop',
      perPage: {{ section.settings.per_page }},
      perMove: 1,
      gap: 40,
      padding: '12rem',
      pagination: false,
      arrows: false,
      breakpoints: {
        1024: { perPage: 2, padding: 0, gap: 20 },
        640: { perPage: 1.5, padding: 0, gap: 20 }
      }
    }).mount();
  });
</script>


{% schema %}
{
  "name": "<> Experts Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet some of our experts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The best of the best, accredited and certified dog trainers"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Book your free behavior call"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Experts per slide (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Expert image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name and title",
          "default": "Jane Doe – Certified Trainer"
        },
        {
          "type": "text",
          "id": "cert_heading",
          "label": "Certifications heading",
          "default": "Certifications:"
        },
        {
          "type": "textarea",
          "id": "certifications",
          "label": "Certifications details",
          "default": "CPDT-KA\nCertified Professional Dog Trainer – Knowledge Assessed"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "<> Experts Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
