          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-04-10_at_2.05.36_PM.png",
            "title": "\"It was immeasurable and priceless to us and our puppies. It was so comfortable to do it remotely and did the whole job.\"",
            "text": "<p>⭐⭐⭐⭐⭐<br/><br/><strong>Mark, Alila & Mochi</strong><br/>Boston, MA</p>",
