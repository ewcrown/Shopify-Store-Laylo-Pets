{% stylesheet %}
.behavior-booking h2 {
    text-align: center;
    margin-bottom: 10px;
    font-weight: 400;
    font-size: 54px;
    line-height: normal;
    max-width: 600px;
    margin: auto auto 50px;
}
.behavior-booking .subheading {
  font-size: 20px;
  text-align: center;
  margin-bottom: 30px;
}
.behavior-offer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  margin-bottom: 40px;
}
.offer-box, .included-box {
  background: #fff;
  border: 1px solid #ddd;
  padding: 20px;
  border-radius: 8px;
  flex: 1 1 300px;
}
.offer-box .price {
    color: #888;
    font-weight: 400;
    font-size: 52.9px;
    line-height: 33.06px;
    text-decoration: line-through;
    font-family: var(--FONT-STACK-HEADING);
    margin: 0 0 20px;
}
.offer-box .free {
  background: #E2FFE7;
  color: #55A277;
  padding: 5px 15px;
  border-radius: 4px;
  display: inline-block;
  font-weight: 700;
  font-size: 32px;
  line-height: normal;
}
.offer-box .note {
  padding: 0;
  text-align: left;
  margin: 0;
font-weight: 400;
font-size: 16px;
line-height: 25px;
}
.included-box ul {
  padding-left: 20px;
  margin: 0;
}
.included-box li {
font-weight: 400;
font-size: 14.18px;
line-height: 22.15px;
}

.included-box > h3 {
font-weight: 700;
font-size: 12.44px;
line-height: 19.44px;
font-weight: bold;
font-family: var(--FONT-STACK-HEADING);
margin-bottom: 21px;
}

.offer-box-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.offer-box-heading > h3 {
font-weight: 700;
font-size: 12.44px;
line-height: 19.44px;
}

@media (max-width: 768px) {
  .behavior-offer {
    flex-direction: column;
    align-items: stretch;
  }

.offer-box, .included-box {
    flex: auto;
}
.behavior-booking {
  padding:0 !important;
  padding-bottom: 30px !important;
}
.behavior-booking h2 {
  font-size: 32px;
  margin-bottom: 20px;
}
}

.offer-box-paid .price {
  color: #000;
  text-decoration: none;
}
.offer-box-paid .free {
  display: none;
}
{% endstylesheet %}

<section
  class="behavior-booking"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};"
>
  <div class="wrapper">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="subheading">{{ section.settings.subheading }}</div>
    {% endif %}
    <div class="behavior-offer">
      <div class="offer-box {% if section.settings.original_price == "$49" %}offer-box-paid{% endif %}">
        <div class="offer-box-heading">
          <h3>{{ section.settings.offer_heading }}</h3>
          <div class="free">{{ section.settings.free_label }}</div>
        </div>
        <div class="price">{{ section.settings.original_price }}</div>
        <div class="note">{{ section.settings.offer_note }}</div>
      </div>
      <div class="included-box">
        <h3>{{ section.settings.included_heading }}</h3>
        <div class="included-inner-text">
          {{ section.settings.included_text }}
        </div>
      </div>
    </div>

    <div class="behaviour-booking-widget">
      {{ section.settings.widget_code }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "<> Booking Section",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Schedule Your Free"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Behavior Assessment"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$299"
    },
    {
      "type": "text",
      "id": "offer_heading",
      "label": "Offer Heading",
      "default": "CALL PRICED AT:"
    },
    {
      "type": "text",
      "id": "free_label",
      "label": "Free Label",
      "default": "FREE"
    },
    {
      "type": "text",
      "id": "offer_note",
      "label": "Offer Note",
      "default": "FOR LIMITED TIME ONLY"
    },
    {
      "type": "text",
      "id": "included_heading",
      "label": "Including Heading",
      "default": "WHATS INCLUDED:"
    },
    {
      "type": "richtext",
      "id": "included_text",
      "label": "What's Included",
      "default": "<ul><li>45-minute live 1:1 session with a certified dog expert</li><li>A professional assessment of your dog’s needs</li><li>BONUS: PDF guides for training, enrichment, and anxiety</li></ul>"
    },
    {
      "type": "liquid",
      "id": "widget_code",
      "label": "Widget Code Here"
    }
  ],
  "presets": [
    {
      "name": "<> Booking Section"
    }
  ]
}
{% endschema %}