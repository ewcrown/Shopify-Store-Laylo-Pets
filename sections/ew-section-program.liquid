
{% style %}
#ew-foundation-program-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px; 
}

#ew-foundation-program-{{ section.id }} .foundation-program-inner {
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.inner_padding_top }}px;
  padding-bottom: {{ section.settings.inner_padding_bottom }}px;
  padding-right: {{ section.settings.inner_padding_right }}px;
  padding-left: {{ section.settings.inner_padding_left }}px;
  border-radius: 12px;
}

#ew-foundation-program-{{ section.id }} .foundation-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

#ew-foundation-program-{{ section.id }} .foundation-content {
  text-align: center;
  margin-bottom: 50px;
}

#ew-foundation-program-{{ section.id }} .foundation-content h2 {
  color: var(--Black, #1B1B1B);
text-align: center;
font-family: "Big Caslon FB";
font-size: 48px;
font-style: normal;
font-weight: 400;
line-height: 56px; /* 116.667% */
  margin-bottom: 10px;
}

#ew-foundation-program-{{ section.id }} .foundation-content p {
  color: var(--Black, #1B1B1B);
text-align: center;
font-family: var(--FONT-STACK-BODY);
font-size: 30px;
font-style: normal;
font-weight: 400;
line-height: 34.23px; /* 114.098% */
margin-top:0;
}

#ew-foundation-program-{{ section.id }} .foundation-image {
  flex: 1 1 400px;
  max-width: 700px;
}

#ew-foundation-program-{{ section.id }} .foundation-image img {
  width: 100%;
  border-radius: 12px;
}

#ew-foundation-program-{{ section.id }} .foundation-features {
  flex: 1 1 400px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

#ew-foundation-program-{{ section.id }} .foundation-feature {
  padding: 22px;
  border-radius: 8px;
background: var(--White, #FFF);
box-shadow: 0px 3.803px 11.41px 1.902px rgba(0, 0, 0, 0.06);
color: var(--Black, #1B1B1B);
font-family: Inter;
font-size: 18px;
font-style: normal;
font-weight: 400;
line-height: 24px; /* 125% */
}

#ew-foundation-program-{{ section.id }} .foundation-footer {
  text-align: center;
  margin-top: 30px;
}

#ew-foundation-program-{{ section.id }} .foundation-footer a {
  font-size: 24px;
  padding: 16px 40px;
  margin-top: 20px;
}

#ew-foundation-program-{{ section.id }} .foundation-footer p {
  color: #000;
font-family: var(--FONT-STACK-BODY);
font-size: 24px;
font-style: normal;
font-weight: 400;
line-height: normal;
margin-top:10px;
}

/* Responsive */
@media (max-width: 768px) {
  #ew-foundation-program-{{ section.id }} .foundation-container {
    flex-direction: column;
    padding:0;
  }
  #ew-foundation-program-{{ section.id }} {
    padding-top: 40px;
    padding-bottom: 40px; 
  }
  #ew-foundation-program-{{ section.id }} .foundation-content h2 {
    font-size: 30px;
    line-height: 40px;
  } 
  #ew-foundation-program-{{ section.id }} .foundation-content p {
    font-size: 20px;
    line-height: normal;
    margin-bottom:0;
  }
  #ew-foundation-program-{{ section.id }} .foundation-footer p {
    font-size: 18px;
  }
  #ew-foundation-program-{{ section.id }} .foundation-footer a {
    font-size: 18px;
    padding: 16px;
  }
}
{% endstyle %}

<section class="foundation-program" id="ew-foundation-program-{{ section.id }}">
  <div class="wrapper"> 
    <div class="foundation-program-inner"> 
      <div class="foundation-content">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
      <div class="foundation-container">
        {% if section.settings.image != blank %}
          <div class="foundation-image">
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Program image">
          </div>
        {% endif %}

        <div class="foundation-features">
          {% for block in section.blocks %}
            <div class="foundation-feature">{{ block.settings.text }}</div>
          {% endfor %}
        </div>
      </div>
      <div class="foundation-footer">
        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_text }}</a>
        {% endif %}
        {% if section.settings.note_text != blank %}
          <p>{{ section.settings.note_text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Program Section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Dog Foundations Program"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "6 weeks of structure, expert guidance, and accountability"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Book Your Free Behavior Call"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note text",
      "default": "Starting at $125/week"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
  "type": "range",
  "id": "inner_padding_top",
  "label": "Inner Padding Top (px)",
  "default": 40,
  "min": 0,
  "max": 200,
  "step": 4
},
{
  "type": "range",
  "id": "inner_padding_bottom",
  "label": "Inner Padding Bottom (px)",
  "default": 40,
  "min": 0,
  "max": 200,
  "step": 4
},
{
  "type": "range",
  "id": "inner_padding_left",
  "label": "Inner Padding Left (px)",
  "default": 20,
  "min": 0,
  "max": 100,
  "step": 4
},
{
  "type": "range",
  "id": "inner_padding_right",
  "label": "Inner Padding Right (px)",
  "default": 20,
  "min": 0,
  "max": 100,
  "step": 4
}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature text",
          "default": "1x weekly private coaching sessions"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "<> Program Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
