          "settings": {
            "image": "shopify://shop_images/HomeschoolbyLAYLO-TrainingPlan_8fae1891-43a4-47f3-ab2c-c87bf7f4ec01.png",
            "title": "A custom plan made for your dog's needs.",
            "text": "<p>Your dedicated expert (no bots here!) will create a unique custom online dog training plan with weekly milestones and homework based on your dog’s breed, adoption story and training knowledge — all designed to meet your goals.</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        }
      },
