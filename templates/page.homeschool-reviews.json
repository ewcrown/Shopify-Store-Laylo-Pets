    "a1fef923-1a06-42e5-8281-acf46898dc66": {
      "type": "section-columns",
      "blocks": {
        "template--16127693848762__a1fef923-1a06-42e5-8281-acf46898dc66-16865153063e704aed-1": {
          "type": "text_block",
          "settings": {
            "title": "Expert Diagnosis",
            "text": "<p>Based on your dog's history, breed and behavior, we will assess the root of the problem (s) to ensure you fully understand your dog and how to improve their mental and physical state. </p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "template--16127693848762__a1fef923-1a06-42e5-8281-acf46898dc66-16865153063e704aed-2": {
          "type": "text_block",
          "settings": {
            "title": "Pup Behavioral Modification Plan",
            "text": "<p>We'll share an assessment for what is needed to reach your goals at home, including the cues you should teach and roughly how long it will take to improve it. </p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
