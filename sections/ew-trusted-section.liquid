{{ 'ew-trusted-section.css' | asset_url | stylesheet_tag }}

<section class="trusted-section">
  <div class="wrapper">
    <div class="trusted-text">
      <h3>{{ section.settings.heading }}</h3>
    </div>
    <div class="trusted-logos splide" aria-label="Company Logos">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide">
              <img src="{{ block.settings.logo | image_url }}" alt="{{ block.settings.alt_text | escape }}" />
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('.trusted-logos', {
      type: 'loop',
      arrows: false,
      pagination: false,
      perPage: 5,
      gap: '2rem',
      autoScroll: {
        speed: .3,
        pauseOnHover: false,
        pauseOnFocus: false,
        rewind: false,
      },
      breakpoints: {
        1024: { perPage: 4 },
        768:  { perPage: 3 },
        480:  { perPage: 2 }
      }
    }).mount(window.splide.Extensions);
  });
</script>

{% schema %}
{
  "name": "Trusted Companies",
  "tag": "section",
  "class": "section-trusted-companies",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by employees of some of the best companies"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Company Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Company logo"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Trusted Companies",
      "category": "Testimonials",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
