{% style %}
  #ew-section-video-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    text-align: center;
    margin-top:-20px;
  }

  #ew-section-video-{{ section.id }} h3 {
    margin-bottom: 0px;
    background: rgba(31, 41, 79, 0.75);
    color: #FFF;
font-family: var(--FONT-STACK-BODY);
font-size: 24px;
font-style: normal;
font-weight: 400;
line-height: normal;
border-radius:12px 12px 0 0 ;
padding: 10px
  }

  #ew-section-video-{{ section.id }} .ew-video-container {
    position: relative;
  }

  #ew-section-video-{{ section.id }} .ew-video {
    width: 100%;
    border-radius: 0 0 12px 12px;
    display: block;
  }

  #ew-section-video-{{ section.id }} .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #ew-section-video-{{ section.id }} .play-button:hover {
    background: rgba(255, 255, 255, 1);
  }

  #ew-section-video-{{ section.id }} .play-button::before {
    content: '';
    display: block;
    width: 0;
    height: 0;
    border-left: 18px solid #000;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }

  @media(max-width:479px){
    #ew-section-video-{{ section.id }} h3 {
      font-size: 16px;
    }
  }
{% endstyle %}

<section class="ew-section-video" id="ew-section-video-{{ section.id }}">
  <div class="ew-section-video-row">
    <div class="wrapper">
      <div class="ew-section-video-wrap">
        {% if section.settings.heading != blank %}
          <h3>{{ section.settings.heading }}</h3>
        {% endif %}
        {% if section.settings.video != blank %}
          <div class="ew-video-container">
            <video
              id="section-video-{{ section.id }}"
              class="ew-video"
              playsinline
              preload="metadata"
              poster="{{ section.settings.video.preview_image | image_url: width: 1000 }}"
            >
              {% for source in section.settings.video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>

            <button class="play-button" onclick="playVideo('{{ section.id }}')"></button>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  function playVideo(sectionId) {
    const video = document.getElementById('section-video-' + sectionId);
    const playButton = video.nextElementSibling;

    video.play();
    video.setAttribute('controls', 'controls');
    playButton.style.display = 'none';
  }
</script>


{% schema %}
{
  "name": "<> Video Section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch how we help dog parents feel confident again →"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    }
  ],
  "presets": [
    {
      "name": "<> Video Section"
    }
  ]
}
{% endschema %}
