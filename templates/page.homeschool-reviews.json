        "text_block_4kwaAC": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2024-04-08_at_12.17.48_PM.png",
            "title": "\"The training that Choopie and I received is phenomenal! Our trainer, Shannen, was so kind, so understanding, and so professional! So extremely helpful! I didn't have 1 single doubt that this is where we should get our training from! 10/10 absolutely recommend, I've already starting recommending them to my friends, family, and a couple strangers!\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Kaitlynn & Choopie</strong><br/>Columbus, OH</p>",
