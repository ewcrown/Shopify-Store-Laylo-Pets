        "text_block_zKagTb": {
          "type": "text_block",
          "settings": {
            "title": "Canine Nutrition and Health Certification Course - Canine Principles ",
            "text": "<p>This course provides essential training on the proper nutrition, health care, and overall well-being of dogs. It covers topics like essential nutrients, common health issues, natural remedies, and the role of exercise to understand how to care for dogs holistically and effectively.</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "text_block_mFMidR": {
          "type": "text_block",
          "settings": {
            "title": "Continuing Education",
            "text": "<p>Nicole has over a decade of continuing education in Animal Nutrition, Wellness and holistic approaches to pet health including:</p><ul><li>Canine Obesity Management, Dr.Churchill, College of Integrative Veterinary Therapies, 2021</li><li>Feline Nutrition and the Relationship Between Food & Behavior, IAABC, 2020</li><li>Cure & Prevent Dog Illness Using Natural Remedies Course, 2015</li><li>Synergy or Synthetics, Canine Nutrition Course, 2015</li><li>Canine Herbal Basics Course, 2015Certified Pet Food Specialist - DNM University 2014Holistic/Natural Pet Care Course, PennFoster 2014</li></ul>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        }
