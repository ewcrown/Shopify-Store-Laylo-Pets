    "section_columns_NpAFGg": {
      "type": "section-columns",
      "blocks": {
        "text_block_TMBVcM": {
          "type": "text_block",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-06-19_at_10.19.52_PM_127d5ed8-653d-41af-ba05-a0ed2b6f255f.png",
            "title": "\"It was such an amazing investment. As a reactive dog owner, with a virtual outlet I was able to have access to a trainer in a way that kept everyone safe.",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><br/><strong>Anna & Bruno<br/></strong>Rodgers, AR</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/EXt96K74My4",
            "video_link_color": "text-light"
          }
        },
        "text_block_YDL6H4": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-07-01_at_11.51.55_AM.png",
            "title": "\"Homeschool was a fantastic experience that provided both ourselves and our puppy with the training that was needed to get through the more difficult challenges of puppyhood. Our trainer, Stephanie, was an absolutely fantastic teacher and we would recommend her to anyone!\"",
            "text": "<p><strong>⭐⭐⭐⭐⭐<br/><br/>Jeff & Banjo</strong><br/>Westfield, MA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://www.youtube.com/watch?v=o2OEpf85LBk&list=PLlOdJYJHiCuD0wrcneOO_aJ9uGhCmFURo&index=21",
            "video_link_color": "text-light"
          }
        },
        "text_block_TwJbPQ": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-07-01_at_11.58.30_AM.png",
            "title": "\"LAY LO helped our dog overcome his resource guarding issues. Our pup has a little anxiety, so having a stranger in our house may have prevented her from learning. Everything worked out really well and I would definitely recommend them.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Sarah & Amelia<br/></strong>Twinsburg, OH</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://www.youtube.com/watch?v=yTIYtGYXjBo",
            "video_link_color": "text-light"
          }
        },
        "text_block_Vtt48x": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-04-10_at_2.05.36_PM.png",
            "title": "\"It was immeasurable and priceless to us and our puppies. It was so comfortable to do it remotely and did the whole job.\"",
            "text": "<p>⭐⭐⭐⭐⭐<br/><br/><strong>Mark, Alila & Mochi</strong><br/>Boston, MA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://www.youtube.com/watch?v=LX4SFNLn59E",
            "video_link_color": "text-light"
          }
        }
      },
