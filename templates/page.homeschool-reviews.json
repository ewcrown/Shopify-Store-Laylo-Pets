        "text_block_VahHhX": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2024-04-08_at_12.18.51_PM.png",
            "title": "Homeschool by LAY LO has TRULY changed my life! This was my very first time owning a puppy on my own and I had no idea what I was doing. Well 8 weeks later I’m happy to say my dog is fully crate trained! Our trainer was so patient with us and provided all the support I needed to help my dog and I get through this process. I recommend this program to anyone interested in getting their pup trained!!",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Dominoe & Willa</strong><br/>Los Angeles, CA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://www.youtube.com/watch?v=wK7bcT9GAO4",
            "video_link_color": "text-light"
          }
        }
