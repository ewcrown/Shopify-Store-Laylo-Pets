        "2bf18c48-7c74-40af-a27d-07608ac0c28f": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Saks_Fifth_Avenue_Logo.jpg",
            "title": "Retailer Growth",
            "text": "<p>We were humbled to have our products available at exclusive retailers such as Nordstrom, Saks, and Anthropologie. </p>",
            "button_text": "2022",
            "button_link": "",
