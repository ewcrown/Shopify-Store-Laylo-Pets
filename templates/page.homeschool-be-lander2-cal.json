    "121aca7f-e45f-40ef-831b-7ab278c7b6c8": {
      "type": "section-columns",
      "blocks": {
        "72f5ca56-1762-430e-8939-007d3114f377": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-06-19_at_10.19.52_PM.png",
            "title": "\"I thought it was such an amazing investment. As a reactive dog owner, with a virtual outlet, I was able to have access to a trainer that kept everyone safe.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Anna & Bruno<br/></strong>Rogers, AR</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/EXt96K74My4",
            "video_link_color": "text-light"
          }
        },
        "687a1866-f739-4189-8671-a2c1387691d3": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-06-02_at_3.05.17_PM.png",
            "title": "“I loved it. My trainer was amazing. In a perfect world, we can work with her forever. Having that dedicated time with the trainer to see how Savannah was reacting with my instructions was very helpful.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Sharee & Savannah<br/></strong>Atlanta, GA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/tG_eKMRL7yU",
            "video_link_color": "text-light"
          }
        },
        "3f93de7c-fcdf-4ba1-8b44-327cd54fcbb0": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-06-02_at_3.04.17_PM.png",
            "title": "\"I thought it was awesome. Every time Vivi was super helpful when she diagnosed what was going on. Nori has caught on to everything we worked on in the classes.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Jake, Lauren & Nori<br/></strong>Richmond, VA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/EEZrhyOSqA0",
            "video_link_color": "text-light"
          }
        },
        "7784bcd9-2f1c-4607-8044-146980accb95": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Bethany_Oso_-_Image.jpg",
            "title": "\"Compared to puppy school, meeting 1:1 where there are no other dogs around was the absolute best for me and Oso.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Bethany & Oso<br/></strong>Providence, RI</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/wC6YpMA1fS4",
            "video_link_color": "text-light"
          }
        },
        "text_block_Nwpzjm": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/IMG_3447.jpg",
            "title": "Virtual training made it possible for us to practice all of the commands because he simply wouldn’t behave the same for someone else. It was more training for us, than training for him which I loved. ",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Sara & Ozzy<br/></strong>Brooklyn, NY</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/VFlByKPht6w",
            "video_link_color": "text-light"
          }
        },
        "1bf2cdb4-9432-4698-8902-9b5e070937a5": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Tara_Marvn_-_Image_2.png",
            "title": "\"Marvin has made such great progress. Before he was pulling like a maniac and now he’s pretty loose.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Tara & Marvin<br/></strong>Palm Springs, CA</p>",
