    "section_columns_JrLjpA": {
      "type": "section-columns",
      "blocks": {
        "text_block_pEd4zE": {
          "type": "text_block",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/Screen_Shot_2023-06-19_at_10.19.52_PM_127d5ed8-653d-41af-ba05-a0ed2b6f255f.png",
            "title": "\"It was such an amazing investment. As a reactive dog owner, with a virtual outlet I was able to have access to a trainer in a way that kept everyone safe.",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><br/><strong>Anna & Bruno<br/></strong>Rodgers, AR</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/EXt96K74My4",
            "video_link_color": "text-light"
          }
        },
        "text_block_KKxN9R": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-05-08_at_11.36.12_AM.png",
            "title": "\"His separation anxiety has improved a ton! Before, I couldn't evenleave my bedroom without himwhining and now he's completely nomal. I'm very happywith how it turned out\"",
            "text": "<p>⭐⭐⭐⭐⭐<br/><br/><strong>Lillian & Duke</strong><br/>Boston, MA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/ZZFDEIhAaNE",
            "video_link_color": "text-light"
          }
        },
        "text_block_7QnBQF": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-05-08_at_11.37.49_AM.png",
            "title": "Before Homeschool, Pepper was so scared of everything but now she's a lot more confident and perfectly fine. There's no tension on the leash and she'salways looking at me. That's one thing that I was really happy about.",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Lynn & Pepper <br/></strong>Barstow, CA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/DwnxtQJJhko",
            "video_link_color": "text-light"
          }
        },
        "text_block_fbYBwn": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-05-08_at_11.46.51_AM.png",
            "title": "My family and friends have all commented on how well behaved she is now. I would not have gotten this much of a targeted approach had I gone to a smaller group class. I'm going to carry the things you taught us for the rest of my life.",
            "text": "<p><strong>⭐⭐⭐⭐⭐<br/>Julia & Keeta<br/></strong>Rodeo, CA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://www.youtube.com/watch?v=dIsQsUPPTNw&feature=youtu.be",
            "video_link_color": "text-light"
          }
        }
      },
