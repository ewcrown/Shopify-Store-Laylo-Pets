{% style %}
.trusted-section {
  padding: 40px 0;
}

.trusted-section .wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin: 0 auto;
  flex-wrap: wrap;
}

.trusted-text h3 {
  font-size: {{ section.settings.font_size_desktop }}px;
  color: {{ section.settings.text_color }};
  max-width: 300px;
  margin: 0;
}

@media screen and (max-width: 768px) {
  .trusted-text h3 {
    font-size: {{ section.settings.font_size_mobile }}px;
  }
}

.trusted-logos {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.trusted-logos img {
  height: 40px;
  opacity: 0.7;
  filter: grayscale(100%);
  transition: opacity 0.3s;
}

.trusted-logos img:hover {
  opacity: 1;
  filter: grayscale(0%);
}
{% endstyle %}

<section class="trusted-section">
  <div class="wrapper">
    <div class="trusted-text">
      <h3>{{ section.settings.heading }}</h3>
    </div>
    <div class="trusted-logos splide" aria-label="Company Logos">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li class="splide__slide">
              <img src="{{ block.settings.logo | image_url }}" alt="{{ block.settings.alt_text | escape }}" />
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Splide Core + AutoScroll Extension -->
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/js/splide.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.4.0/dist/js/splide-extension-auto-scroll.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('.trusted-logos', {
      type: 'loop',
      arrows: false,
      pagination: false,
      perPage: 5,
      gap: '2rem',
      autoScroll: {
        speed: 0.3,
        pauseOnHover: false,
        pauseOnFocus: false,
        rewind: false,
      },
      breakpoints: {
        1024: { perPage: 4 },
        768:  { perPage: 3 },
        480:  { perPage: 2 }
      }
    }).mount(window.splide.Extensions);
  });
</script>

{% schema %}
{
  "name": "Trusted Companies",
  "tag": "section",
  "class": "section-trusted-companies",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by employees of some of the best companies"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Heading Font Size (Desktop)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Company Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Company logo"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Trusted Companies",
      "category": "Testimonials",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
