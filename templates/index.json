    "666a84f2-08d1-4de2-9408-68bd2419fcaf": {
      "type": "section-testimonials",
      "blocks": {
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-0": {
          "type": "text",
          "settings": {
            "heading": "Trusted by thousands of dog parents",
            "text_size": 125,
            "subheading": "<p>4.8 average<br/>2000+ reviews</p>",
            "block_color": "#000000",
            "text_color": "text-light",
            "text_alignment": "text-left"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-1": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>\"This was my very first time owning a puppy on my own and I had no idea what I was doing. Well 8 weeks later I’m happy to say my dog is fully crate trained!\"</p>",
            "customer_name": "Dominoe & Willa",
            "subheading": "<p>Los Angeles, CA</p>"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-6": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>These beds are amazing quality. Very well thought out. The fabric and detail on the cover is really fantastic. Excellent communication and <br/>packaged beautifully.</p>",
            "customer_name": "Darren C.",
            "subheading": "<p>Verified customer</p>"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-2": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>\"I’ve gone from having a puppy who tears everything apart to a very lovely little pup who actually listens to me without commands. I can’t thank the team enough for making my life a lot easier.\"</p>",
            "customer_name": "Linnea & Cookie",
            "subheading": "<p>Westfield, NJ</p>"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-5": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>Superb customer service and can’t say enough how great the quality is of their product!! I recommend this business and their products to <br/>everyone. </p>",
            "customer_name": "Sandra B.",
            "subheading": "<p>Verified customer</p>"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-3": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>\"Virtual training made it possible for us to practice all of the commands because he simply wouldn’t behave the same for someone else. It was more training for us, than training for him which I loved.\"</p>",
            "customer_name": "Sarah & Ozzie",
            "subheading": "<p>Brooklyn, NY</p>"
          }
        },
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-4": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "text": "<p>\"His separation anxiety has improved a ton! Before, I couldn't even leave my bedroom without him whining and now he's completely normal.</p>",
            "customer_name": "Lillian & Duke",
            "subheading": "<p>Boston, MA</p>"
          }
        }
      },
      "block_order": [
        "template--16010683547834__666a84f2-08d1-4de2-9408-68bd2419fcaf-1672788615f8f36688-0",
