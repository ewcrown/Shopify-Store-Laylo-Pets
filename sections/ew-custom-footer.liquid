{% style %}
.site-footer {
  background-color: #f3f3f3;
  color: #000;
  padding: 40px 20px;
  font-family: 'Helvetica Neue', sans-serif;
  font-size: 14px;
}

.footer-content {
  text-align: center;
}

.footer-logo img {
  max-width: 223px;
  margin: 0 auto;
}

.footer-divider {
    border: none;
    border-top: 1px solid #000;
    margin: 40px 0;
    width: 100%;
}

.footer-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin:0 auto;
  max-width:1000px;
}

.footer-copy {
  margin: 0;
font-weight: 400;
font-size: 14px;
line-height: 150%;
letter-spacing: 0%;
color: #2D2E31;
}

.footer-links,
.footer-social {
  list-style: none;
  padding: 0;
  margin: 5px 0;
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  justify-content: center;
}

.footer-links li a,
.footer-social li a {
color:#2D2E31;
font-weight: 400;
font-size: 14px;
line-height: 150%;
text-decoration: underline;
text-decoration-style: solid;
text-decoration-thickness: 0%;

}

.footer-social i {
  font-size: 16px;
}

/* Responsive Styles */
@media (min-width: 768px) {
  .footer-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
  }

  .footer-copy {
    flex: 1;
    text-align: left;
  }

  .footer-links {
    flex: 2;
    justify-content: center;
  }

  .footer-social {
    flex: 1;
    justify-content: flex-end;
  }
  
}
{% endstyle %}

<div class="site-footer" style="background-color: {{ section.settings.background_color }};" itemscope itemtype="http://schema.org/WPFooter">
  <div class="footer-content wrapper">
    {% if section.settings.footer_logo %}
      <div class="footer-logo">
        <img src="{{ section.settings.footer_logo | image_url: width: 200 }}" alt="LAY LO logo" itemprop="logo">
      </div>
    {% endif %}

    <hr class="footer-divider">

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} LAY•LO. All rights reserved.
      </p>

      <ul class="footer-links">
        {% if section.settings.privacy_policy_url != blank %}
          <li><a href="{{ section.settings.privacy_policy_url }}">Privacy Policy</a></li>
        {% endif %}
        {% if section.settings.terms_url != blank %}
          <li><a href="{{ section.settings.terms_url }}">Terms of Service</a></li>
        {% endif %}
        {% if section.settings.cookies_url != blank %}
          <li><a href="{{ section.settings.cookies_url }}">Cookies Settings</a></li>
        {% endif %}
      </ul>

      <ul class="footer-social">
        {% if section.settings.facebook_url %}
          <li><a href="{{ section.settings.facebook_url }}" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a></li>
        {% endif %}
        {% if section.settings.instagram_url %}
          <li><a href="{{ section.settings.instagram_url }}" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a></li>
        {% endif %}
        {% if section.settings.twitter_url %}
          <li><a href="{{ section.settings.twitter_url }}" target="_blank" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a></li>
        {% endif %}
        {% if section.settings.linkedin_url %}
          <li><a href="{{ section.settings.linkedin_url }}" target="_blank" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a></li>
        {% endif %}
        {% if section.settings.youtube_url %}
          <li><a href="{{ section.settings.youtube_url }}" target="_blank" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a></li>
        {% endif %}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "url",
      "id": "privacy_policy_url",
      "label": "Privacy Policy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service URL"
    },
    {
      "type": "url",
      "id": "cookies_url",
      "label": "Cookies Settings URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f3f3f3"
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "category": "Footer"
    }
  ]
}
{% endschema %}