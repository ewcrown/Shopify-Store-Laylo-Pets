    "bf09f991-7e3a-4cff-b515-3225a6d06b60": {
      "type": "section-icons-row",
      "blocks": {
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-0": {
          "type": "text",
          "settings": {
            "icon_name": "support",
            "title": "1. Evaluate your pup",
            "text": "<p>Your free initial call will help understand your challenges and walk away with actionable tips on how to solve it.</p>"
          }
        },
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-1": {
          "type": "text",
          "settings": {
            "icon_name": "calendar",
            "title": "2. Get matched with your expert",
            "text": "<p>If you move forward with a plan, we'll schedule a 1-on-1 session with your certified expert who is the best fit for you and your dog's goals.</p>"
          }
        },
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-2": {
          "type": "text",
          "settings": {
            "icon_name": "award",
            "title": "3. Learn from the best of the best.",
            "text": "<p>Your dedicated expert will work directly  with you and your dog throughout your program and be there to help along the way. This is where the fun begins!</p>"
          }
        }
      },
      "block_order": [
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-0",
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-1",
        "template--16036805083322__bf09f991-7e3a-4cff-b515-3225a6d06b60-1677079215bbc5ef89-2"
      ],
      "settings": {
        "alignment": "center",
        "columns": 3,
        "icons_width": 30,
        "heading": "Ready to get help today?",
        "subheading": "",
        "bg_color_secondary": false,
        "box_color": "",
        "text_color": "#000000",
        "button_text": "Book Your Free Call >",
        "button_link": "https://www.laylopets.com/pages/free-consultation-booking-page",
        "button_style": "btn--primary",
        "enable_slider_mobile": false,
        "padding_top": 60,
