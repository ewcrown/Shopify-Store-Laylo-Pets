          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Gabriela_First_Garage_Studio.png",
            "title": "Humble Beginnings",
            "text": "<p>We launched our first dog bed on Etsy made from upcycled fabrics we sourced globally. Starting from a garage, we made every bed made-to-order, and word got out.</p>",
            "button_text": "2018",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
