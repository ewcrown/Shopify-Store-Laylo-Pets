                      assign enable_variant_boxes = true
                    endif

                    capture selector_wrapper_class
                      echo 'selector-wrapper'
                      if enable_variant_boxes
                        echo ' selector-wrapper--boxes'
                      endif

                      if enable_color_swatches
                        echo ' selector-wrapper--swatches'
                      endif
                    endcapture
