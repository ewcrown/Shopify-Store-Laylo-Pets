        "template--16059996111034__3f34e5da-6cb0-40ff-b532-99377ec775fa-1685743622c146d6f3-1": {
          "type": "text",
          "settings": {
            "text_position": "center",
            "top_image_width": 100,
            "text_color": "text-dark",
            "subheading": "$125 / Week",
            "title": "Homeschool Premium",
            "text": "<p><strong>Personalized, private 1:1 online training with your dedicated dog expert. Guaranteed results. <br/></strong></p><p><strong>4, 6 and 8 week packages available<br/><br/><br/></strong>Intensive Pup Evaluation</p><p>1x Weekly Live 1:1 Sessions (45 min)</p><p>2x Weekly Private Practice Sessions (15-min)</p><p>Message-an-Expert</p><p>Personalized Training Plan</p><p>LAY LO™ Product Discounts</p><p>Homeschool Training Guarantee*</p><p>* * * </p><p>Insider Community Access</p><p>Course Membership Library - Full Access ($150 value)</p>",
            "button_text": "Schedule Your Free Pup Evaluation",
            "button_link": "https://www.laylopets.com/pages/book-a-free-call",
