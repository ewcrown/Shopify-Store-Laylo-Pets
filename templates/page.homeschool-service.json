    "columns": {
      "type": "section-columns",
      "blocks": {
        "column-0": {
          "type": "text_block",
          "settings": {
            "title": "Holistic support",
            "text": "<p>Knowing that most behaviors are solved through more than training,<span style=\"text-decoration:underline\">your holistic plan</span> is designed to solve the ENTIRE problem, giving you a better understanding of your dog and a lifetime of results. </p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "column-1": {
          "type": "text_block",
          "settings": {
            "title": "Reduced distractions",
            "text": "<p>Training in your dog’s current environment without new smells and distractions is proven to drive faster long-term results. </p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        },
        "column-2": {
          "type": "text_block",
          "settings": {
            "title": "Train on your terms",
            "text": "<p>Cut the commute and start training in the comfort of your living room. With virtual recorded calls and an extensive video library, the whole family can get involved wherever they are.</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "",
            "video_link_color": "text-dark"
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
