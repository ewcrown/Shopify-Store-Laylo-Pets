            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/DYOJo_SrwhI",
            "video_link_color": "text-light"
          }
        },
        "80497941-0b8c-417f-a548-7829b23725ae": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/Screenshot_2024-01-16_at_12.37.13_PM.png",
            "title": "\"Being able to train at his homebase with his family was a huge plus. When we did a simulation of a work. We will recommend it to other people full heartedly.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Chinami & Mochi<br/></strong>Los Angeles, CA</p>",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--text",
            "video_link_popup": "https://youtu.be/rUCLC9ohB4Q",
            "video_link_color": "text-light"
          }
        },
        "text_block_gWKYfi": {
          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/386430789_659185492994198_6348077567033783363_n.jpg",
            "title": "\"I’ve gone from having a puppy who tears everything apart to a very lovely little pup who actually listens to me without commands. I can’t thank the team enough for making my life a lot easier.\"",
            "text": "<p>⭐⭐⭐⭐⭐</p><p><strong>Linnea & Cookie<br/></strong>Westfield, NJ</p>",
